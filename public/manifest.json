{
  "name": "T-eraClip",
  "description": "Clip anything. Turn it into action.",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": ["storage", "contextMenus", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "T-eraClip"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
